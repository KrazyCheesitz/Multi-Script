{
  "manifest_version": 3,
  "name": "Multi-Script \u00b7 Multi-Engine AI Studio",
  "version": "5.3.1",
  "description": "Customizable multi-provider AI workflows for Roblox, Unity, Godot, Blender, Figma, and MCP tools.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://notion.ai/*",
    "https://www.notion.ai/*",
    "https://notion.so/*",
    "https://www.notion.so/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Multi-Script",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/deepseek.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/chatgpt.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/gemini.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kimi.ai/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/kimi.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.z.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/glm.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arena.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/arena.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/meta.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "providers/qwen-net.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/qwen.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notion.ai/*",
        "https://www.notion.ai/*",
        "https://notion.so/*",
        "https://www.notion.so/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/notion.js",
        "core/tool-routing.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "Multi-Script",
  "version_name": "5.3.1 Notion Trial Guidance"
}
